<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View library.book View List -->
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">view.library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="published_date"/>
                <field name="pages"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- View library.book form -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">view.library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Library Book">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="Basic Info." string="Basic Info.">
                            <field name="author"/>
                            <field name="isbn"/>
                            <field name="published_date"/>
                            <field name="pages"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action library.book -->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Library book menu -->
    <menuitem
        id="library_book_menu"
        name="Books"
        action="library_book_action"
        parent="library_root_menu"/>
</odoo>
